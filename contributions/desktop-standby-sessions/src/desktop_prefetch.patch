+    def promote(self, job, series_id, episode):
+        if job.cancelled.is_set():
+            return False
+        # Called under HlsJobs.guard: transfer the generation before a later
+        # foreground create can overtake this activation.
+        generation = self.begin(job, series_id, episode,
+            expected_generation=getattr(job, "prefetch_generation", self.generation))
+        if generation is None:
+            return False
+        def load_after_detach():
+            try:
+                threading.Thread(target=self._load_promoted,
+                    args=(job, series_id, episode, generation),
+                    name="desktop-standby-metadata", daemon=True).start()
+            except RuntimeError:
+                if getattr(job, "_prefetch_work_finished", False) or job.video_mode == "native":
+                    self.finish(job, series_id, episode, job.source)
+        return load_after_detach
+
+    def _load_promoted(self, job, series_id, episode, generation):
+        with self.condition:
+            invalid = self.closed or job.cancelled.is_set() or generation != self.generation
+            finish_cancelled = invalid and (getattr(job, "_prefetch_work_finished", False) or job.video_mode == "native")
+            if invalid and finish_cancelled and self.foreground.get(job.id) == generation:
+                self.foreground.pop(job.id, None)
+                if self.busy == job.id:
+                    self.busy = None
+                self.condition.notify_all()
+        if invalid:
+            if finish_cancelled and generation == self.generation:
+                self.finish(job, series_id, episode, job.source)
+            return
+        try:
+            source = self.load_source(series_id, episode, prepared_source=job.source)
+        except Exception:
+            source = None  # Optional future-download metadata must not affect playback.
+        with self.condition:
+            # HLS may still be encoding after its first frame is playable.
+            # Activation must retain its existing encoding slot until the
+            # actual worker finishes. If it finished during metadata loading,
+            # refresh bookkeeping now that the episode list is available.
+            finish_now = getattr(job, "_prefetch_work_finished", False) or job.video_mode == "native"
+            if finish_now and generation == self.generation:
+                self.foreground[job.id] = generation
+        if finish_now:
+            # finish reports state; never hold condition while acquiring the
+            # diagnostic report lock, whose snapshot acquires condition.
+            self.finish(job, series_id, episode, source)
