+    def promote(self, job, series_id, episode):
+        if job.cancelled.is_set():
+            return False
+        # Called under HlsJobs.guard: transfer the generation before a later
+        # foreground create can overtake this activation.
+        generation = self.begin(job, series_id, episode,
+            expected_generation=getattr(job, "prefetch_generation", self.generation))
+        if generation is None:
+            return False
+        def load_after_detach():
+            try:
+                threading.Thread(target=self._load_promoted,
+                    args=(job, series_id, episode, generation),
+                    name="desktop-standby-metadata", daemon=True).start()
+            except RuntimeError:
+                if getattr(job, "_prefetch_work_finished", False) or job.video_mode == "native":
+                    self.finish(job, series_id, episode, job.source)
+        return load_after_detach
+
+    def _load_promoted(self, job, series_id, episode, generation):
+        with self.condition:
+            invalid = self.closed or job.cancelled.is_set() or generation != self.generation
+            if not invalid: job._prefetch_metadata_generation = generation
+            finish_cancelled = invalid and (getattr(job, "_prefetch_work_finished", False) or job.video_mode == "native")
+            if invalid and finish_cancelled and self.foreground.get(job.id) == generation:
+                self.foreground.pop(job.id, None)
+                self.foreground_directories.pop(job.id, None)
+                if self.busy == job.id:
