+    def load_standby_source(self, job, series_id, episode):
+        def current_generation():
+            with self.condition:
+                if (self.closed or job.cancelled.is_set() or not job.prewarm_parent
+                        or job.prefetch_generation != self.generation):
+                    raise EncodingCancelled()
+        current_generation()
