+    def activate(self, job):
+        """Transfer bookkeeping synchronously; metadata remains asynchronous."""
+        after_detach = None
+        with self.guard:
+            if job.cancelled.is_set():
+                raise HTTPException(404, "Desktop session is unavailable")
+            if job.failed:
+                raise HTTPException(409, "Standby failed")
+            if not job.prewarm_parent:
+                return  # Already activated: idempotent success.
+            parent = self.jobs.get(job.prewarm_parent)
+            if parent and parent.video_mode == "native" and job.video_mode != "native":
+                raise HTTPException(409, "Cross-mode standby audio handoff unsupported")
+            if job.video_mode == "native":
+                value = self.native.snapshot(job.id) if self.native else None
+                if (not value or not value.get("visible") or not value.get("outputReady")
+                        or job.activation_revision is None
+                        or value.get("revision", -1) < job.activation_revision):
+                    raise HTTPException(409, "Standby activation not applied")
+            if self.on_activate:
+                accepted = self.on_activate(job, job.series_id, job.episode)
+                if accepted is False:
+                    raise HTTPException(409, "Standby generation expired")
+                if callable(accepted):
+                    after_detach = accepted
+            if job.video_mode == "native":
+                commit = getattr(self.native, "commit_handoff", None)
+                if commit: commit(job.id)
+            job.prewarm_parent = None
+            self.foreground_generation = job.prefetch_generation
+        if after_detach:
+            after_detach()
 
