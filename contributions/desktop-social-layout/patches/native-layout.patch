+def decode_controls_overlay(value):
+    # Neither filesystem paths, memory pointers nor mpv commands cross this API.
+    if not isinstance(value, dict) or set(value) != {"x", "y", "width", "height", "data"}:
+        raise ValueError("Invalid controls overlay")
+    x, y, width, height = (value[key] for key in ("x", "y", "width", "height"))
+    if (any(type(v) is not int for v in (x, y, width, height))
+            or not 0 <= x <= 32768 or not 0 <= y <= 32768
+            or not 1 <= width <= 8192 or not 1 <= height <= 512
+            or width * height > 1048576 or x + width > 32768 or y + height > 32768
+            or not isinstance(value["data"], str) or len(value["data"]) > 524288):
+        raise ValueError("Invalid controls overlay")
+    try:
+        compressed = base64.b64decode(value["data"], validate=True)
+        decoder = zlib.decompressobj()
+        pixels = decoder.decompress(compressed, width * height * 4 + 1)
+        if (len(pixels) != width * height * 4 or not decoder.eof
+                or decoder.unused_data or decoder.unconsumed_tail):
+            raise ValueError("Invalid controls pixels")
+    except (ValueError, zlib.error) as error:
+        raise ValueError("Invalid controls overlay") from error
+    return {"x": x, "y": y, "width": width, "height": height, "pixels": pixels}
