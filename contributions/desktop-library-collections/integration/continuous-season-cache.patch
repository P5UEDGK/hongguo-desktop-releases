+                elif self.continuation_enabled:
+                    self.next_attempt = None
+                self.next_lookup = None
+                ahead = self.ahead
+                changed_generation = generation != self.generation
+                self.condition.notify_all()
+            if not valid and (changed_generation or self.continuation_enabled):
