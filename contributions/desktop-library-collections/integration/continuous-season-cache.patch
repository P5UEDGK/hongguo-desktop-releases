+    def _sequence_items(self):
+        # Positions are local to this generation, not episode numbers in a season.
+        # Keep latest_episodes unchanged for the host's strict season-end checks.
+        items = list(self.latest_episodes)
+        if self.continuation_enabled and self.ahead is not None and self.next_season and items:
+            offset = items[-1][0]
+            items.extend((offset + index, vid) for index, vid in self.next_season[1])
+        return items
+
+    def _selected_items(self):
+        if not self.current:
+            return []
+        result, seen = [], set()
+        for position, vid in self._sequence_items():
+            if position > self.current['episode'] and vid not in seen:
+                if self.ahead is not None and len(result) >= self.ahead:
+                    break
+                result.append((position, vid))
+                seen.add(vid)
+        return result
+
+    def _task_allowed(self, position):
+        return bool(self.current and (position == self.current['episode'] or
+                    any(index == position for index, _ in self._selected_items())))
+
+    def set_continuation(self, job, enabled):
+        if type(enabled) is not bool:
+            raise ValueError('Continuation must be boolean')
+        with self.condition:
+            if (self.closed or enabled and (job.cancelled.is_set() or job.failed) or
+                    getattr(job, 'prefetch_generation', None) != self.generation or
+                    self.current != {'seriesId': job.series_id, 'episode': job.episode}):
+                return False
+            if self.continuation_enabled != enabled:
+                self.continuation_epoch += 1
+                self.continuation_enabled = enabled
+            ahead = self.ahead
+        self.reconfigure(ahead)
+        return True
+
+    def _maybe_next_season(self):
+        with self.condition:
+            if (self.closed or not self.current or not self.continuation_enabled or
+                    self.next_season_loader is None or self.ahead is None or not self.ahead or
+                    not self.latest_episodes or self.next_season is not None or
+                    self.next_attempt == self.generation or self.next_lookup is not None or
+                    len(self._selected_items()) >= self.ahead):
+                return
+            generation, epoch, sid = self.generation, self.continuation_epoch, self.current['seriesId']
+            self.next_attempt = generation
+            worker = threading.Thread(target=self._load_next_season, args=(generation, epoch, sid),
+                                      name='desktop-next-season-metadata', daemon=True)
+            self.next_lookup = worker
+            try:
+                worker.start()
+            except RuntimeError:
+                self.next_lookup = None
+
+    def _load_next_season(self, generation, epoch, sid):
+        value, failed = None, False
+        try:
+            value = self.next_season_loader(sid)
+            if value:
+                next_id, metadata = value
