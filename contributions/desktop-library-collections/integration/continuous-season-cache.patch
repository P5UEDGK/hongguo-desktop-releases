+                        or next_id == sid):
+                    raise ValueError('Invalid next season identity')
+                prefix = []
+                for index, vid in self._episodes(metadata):
+                    if index != len(prefix) + 1:
+                        break
+                    prefix.append((index, vid))
+                if not prefix:
+                    raise ValueError("Next season first episode unavailable")
+                value = (next_id, prefix)
+        except Exception:
+            failed = True
+            value = None
+        finally:
+            with self.condition:
+                valid = (not self.closed and generation == self.generation and
+                         epoch == self.continuation_epoch and self.continuation_enabled)
+                if valid:
