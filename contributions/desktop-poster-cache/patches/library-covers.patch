+    def covers(self, ids, local_only=False):
+        if not isinstance(ids, list) or not 1 <= len(ids) <= 20 or any(type(sid) is not str or not identity(sid) for sid in ids):
+            raise ValueError("每次最多读取20张有效剧集封面")
+        if type(local_only) is not bool:
+            raise ValueError("localOnly 必须为布尔值")
+        posters = self.posters
+        if posters is None:
+            raise OSError("封面缓存尚未就绪")
+        ids = list(dict.fromkeys(ids))
+        result = {sid: data for sid in ids if (data := posters.read(sid))}
+        local_hits = len(result)
+        initial = {"covers": result, "missing": [sid for sid in ids if sid not in result], "localHits": local_hits}
+        if not local_only:
+            for update in self.cover_updates(ids, initial, posters):
+                result.update(update["covers"])
+            initial["missing"] = [sid for sid in ids if sid not in result]
+        return initial
+
+    def cover_updates(self, ids, initial=None, posters=None):
+        """Publish disk hits first, then each download in completion order."""
+        posters = posters or self.posters
+        initial = initial if initial is not None else self.covers(ids, local_only=True)
+        # A request can become warm between the local probe and the stream.
+        # Keep each frame within the same single-image bound as downloads.
+        if initial["covers"]:
+            for sid, data in initial["covers"].items():
+                yield {**initial, "covers": {sid: data}}
+        else:
+            yield initial
+        missing = [sid for sid in initial["missing"] if posters.ready_to_fetch(sid)]
+        if not missing:
+            return
+        # Known image URLs are read through WAL without the relationship lock.
+        # A background relationship lookup (or an unknown sibling in this batch)
+        # must not hold up downloads that already have an address.
+        with self.connect() as db:
+            known = {sid: url for sid, url in db.execute(
+                "SELECT series_id,url FROM poster_urls WHERE series_id IN ("
+                + ",".join("?" for _ in missing) + ")", missing) if cover_url(url)}
+        unknown = [sid for sid in missing if sid not in known]
+        with ThreadPoolExecutor(max_workers=6) as pool:
+            work = {pool.submit(self._fetch_cover, posters, {"seriesId": sid, "coverUrl": url}): sid
+                    for sid, url in known.items()}
+            metadata = pool.submit(self.resolve, unknown, require_covers=True) if unknown else None
+            if metadata is not None:
+                work[metadata] = None
+            while work:
+                completed, _ = wait(work, return_when=FIRST_COMPLETED)
+                for future in completed:
+                    sid = work.pop(future)
+                    if future is metadata:
+                        for row in future.result()["relations"]:
+                            work[pool.submit(self._fetch_cover, posters, row)] = row["seriesId"]
+                    else:
+                        data = future.result()
+                        yield {"covers": {sid: data} if data else {}, "missing": [] if data else [sid]}
+
+    def _fetch_cover(self, posters, row):
+        sid = row["seriesId"]
+        data = posters.get(sid, row.get("coverUrl"))
+        if not data and row.get("coverUrl"):
+            # Keep the shared cooldown, but refresh an expired URL on retry.
+            with self.connect() as db:
+                db.execute("DELETE FROM poster_urls WHERE series_id=? AND url=?", (sid, row["coverUrl"]))
+        return data
 
