+    def covers(self, ids):
+        if not isinstance(ids, list) or not 1 <= len(ids) <= 20 or any(type(sid) is not str or not identity(sid) for sid in ids):
+            raise ValueError("每次最多读取20张有效剧集封面")
+        posters = self.posters
+        if posters is None:
+            raise OSError("封面缓存尚未就绪")
+        ids = list(dict.fromkeys(ids))
+        result = {sid: data for sid in ids if (data := posters.read(sid))}
+        local_hits = len(result)
+        missing = [sid for sid in ids if sid not in result and posters.ready_to_fetch(sid)]
+        if missing:
+            rows = self.resolve(missing, require_covers=True)["relations"]
+            with ThreadPoolExecutor(max_workers=6) as pool:
+                images = pool.map(lambda row: posters.get(row["seriesId"], row.get("coverUrl")), rows)
+                for row, data in zip(rows, images):
+                    if data:
+                        result[row["seriesId"]] = data
+                    elif row.get("coverUrl"):
+                        # A signed URL may have expired. After the shared failure
+                        # cooldown, refresh only this missing/corrupt poster URL.
+                        with self.connect() as db:
+                            db.execute("DELETE FROM poster_urls WHERE series_id=? AND url=?",
+                                       (row["seriesId"], row["coverUrl"]))
